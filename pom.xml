<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.promethea.atlas</groupId>
	<artifactId>atlas-waypoint-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Atlas Waypoint Backend</name>
	<description>Torre de control de flota: API reactiva, ingesta de telemetría y reglas de alertas</description>
	<url>https://github.com/MiguelParra4573/atlas-waypoint-backend</url>
	<properties>
		<java.version>21</java.version>
		<!-- Interruptor de -Werror. En true, cualquier warning de javac rompe el
		     build. Se apaga con -Dcompilacion.fallarPorWarning=false el dia de un
		     upgrade de Boot o de JDK, para poder compilar y migrar; CI nunca pasa
		     ese flag, asi que CI siempre es estricto. Ver convenciones.md. -->
		<compilacion.fallarPorWarning>true</compilacion.fallarPorWarning>
		<maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
		<spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Reglas del entorno. En validate, para que fallen en segundos, antes
			     de cualquier descarga o compilacion. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer-plugin.version}</version>
				<executions>
					<execution>
						<id>reglas-del-entorno</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<!-- El wrapper fija 3.9.16 y es only-script: si alguien corre el
								     `mvn` del PATH, puede ser cualquier version, incluida Maven 4,
								     cuya resolucion de pluginManagement difiere. Esta regla hace
								     que el fallo diga "usa el wrapper". -->
								<requireMavenVersion>
									<version>[3.9.16,)</version>
								</requireMavenVersion>
								<!-- Rango cerrado a proposito: el harness se acopla a internals de
								     javac (google-java-format, Error Prone). Con JDK 25 el fallo no
								     seria "version no soportada" sino un IllegalAccessError
								     incomprensible. Al migrar se sube este rango y setup-java en el
								     mismo PR. -->
								<requireJavaVersion>
									<version>[21,22)</version>
								</requireJavaVersion>
								<banDuplicatePomDependencyVersions/>
								<!-- Prohibe LATEST, RELEASE y rangos: es lo que garantiza que el
								     build de hace tres meses de el mismo resultado. -->
								<banDynamicVersions>
									<allowSnapshots>false</allowSnapshots>
								</banDynamicVersions>
								<requireReleaseDeps/>
								<!-- Sin <repositories> propios: un repo extra vuelve el build
								     dependiente de un host que puede caerse o cambiar contenido. -->
								<requireNoRepositories/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Formato del codigo. `./mvnw spotless:apply` formatea; spotless:check
			     falla el build. El formateador es google-java-format en modo AOSP
			     (4 espacios de bloque, 8 de continuacion, 100 columnas), que es
			     exactamente el estilo que el codigo ya practicaba a mano. Ver ADR 0004. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless-maven-plugin.version}</version>
				<configuration>
					<lineEndings>GIT_ATTRIBUTES</lineEndings>
					<java>
						<includes>
							<include>src/**/*.java</include>
						</includes>
						<googleJavaFormat>
							<!-- Sin <version>: la fija Spotless, que esta pineado exacto. -->
							<style>AOSP</style>
							<!-- Reparte de forma estable los literales largos (las consultas
							     @Query), en vez de dejar una particion que el siguiente apply
							     vuelva a mover. -->
							<reflowLongStrings>true</reflowLongStrings>
							<formatJavadoc>true</formatJavadoc>
						</googleJavaFormat>
						<!-- Unico paso que agrega algo sobre google-java-format: deja las
						     anotaciones TYPE_USE en la misma linea que el tipo. Necesario para
						     que `@Id @Nullable UUID id` quede legible en la etapa 8. -->
						<formatAnnotations/>
						<!-- Sin importOrder ni removeUnusedImports: los hace el propio paso de
						     google-java-format (fixImports), y dos motores sobre el mismo
						     archivo se pelean en cada apply. -->
					</java>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- <parameters>true</parameters> y <release>21</release> ya los pone
					     spring-boot-starter-parent; repetirlos aqui es ruido. -->
					<showWarnings>true</showWarnings>
					<showDeprecation>true</showDeprecation>
					<failOnWarning>${compilacion.fallarPorWarning}</failOnWarning>
					<compilerArgs>
						<!-- Excluidos: `processing` (ruido garantizado en cuanto entre un
						     procesador de anotaciones), `serial` (serialVersionUID es cargo
						     cult en un servicio que serializa a JSON), `this-escape` (altisima
						     tasa de ruido en constructores legitimos), y los tres de JPMS, que
						     solo aplican con module-info.java. Se mantienen deprecation y
						     removal, que son la senal que importa en la migracion a Spring 7. -->
						<arg>-Xlint:all,-processing,-serial,-this-escape,-missing-explicit-ctor,-requires-automatic,-requires-transitive-automatic</arg>
					</compilerArgs>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
